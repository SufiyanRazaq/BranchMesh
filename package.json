{
  "name": "branchmesh",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "description": "Detect Git branches that pass independently but fail when combined.",
  "type": "module",
  "bin": {
    "branchmesh": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts .agents/skills/branchmesh/scripts tsup.config.ts vitest.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "build": "tsup",
    "prepack": "npm run build",
    "demo": "npm run build --silent && npm run demo:verify",
    "demo:scan": "node dist/cli.js demo",
    "demo:verify": "node scripts/verify-demo.mjs",
    "report:verify": "vitest run tests/unit/sampleArtifacts.test.ts",
    "skill:verify": "node .agents/skills/branchmesh/scripts/run-branchmesh.mjs demo --verify",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run demo:verify && npm run report:verify && npm run skill:verify"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
